import pandas as pd
import yfinance as yf
import numpy as np

def load_data(ticker, start, end):
    """
    Downloads historical stock data from Yahoo Finance.
    """
    print(f"1. Loading data for {ticker}...")
    df = yf.download(ticker, start=start, end=end)
    return df

def calculate_indicators(df):
    """
    Calculates the moving averages (MA50, MA200).
    """
    print("2. Calculating indicators (MA50, MA200)...")
    df['MA50'] = df['Close'].rolling(window=50).mean()
    df['MA200'] = df['Close'].rolling(window=200).mean()
    return df

def create_strategy(df):
    """
    Creates trading signals based on the Golden Cross strategy
    and identifies the exact trade days.
    """
    print("3. Creating strategy and signals...")
    # Use .copy() to avoid the SettingWithCopyWarning
    df_clean = df.dropna().copy()
    
    # Create the signal (1 = Buy/In, 0 = Sell/Out)
    df_clean['signal'] = np.where(df_clean['MA50'] > df_clean['MA200'], 1, 0)
    
    # Find the trade days (1.0 = Buy, -1.0 = Sell)
    df_clean['position'] = df_clean['signal'].diff()
    return df_clean

def run_backtest(df, commission=0.001):
    """
    Calculates the performance of the strategy vs. Buy & Hold,
    including transaction costs.
    """
    print(f"4. Running backtest (commission: {commission * 100}%)")
    
    # 1. Buy & Hold return
    df['daily_return'] = df['Close'].pct_change()
    
    # 2. Strategy return (using 'signal', not 'position')
    df['strategy_return'] = df['daily_return'] * df['signal'].shift(1)

    # 3. Add transaction costs
    trade_days = df['position'].abs() == 1.0
    df.loc[trade_days, 'strategy_return'] = df.loc[trade_days, 'strategy_return'] - commission

    # 4. Calculate cumulative returns
    df['buy_hold_total'] = (df['daily_return'] + 1).cumprod()
    df['strategy_total'] = (df['strategy_return'] + 1).cumprod()
    
    return df

def print_results(df):
    """
    Prints the final performance analysis.
    """
    print("\n--- Trade Days (1.0 = Buy, -1.0 = Sell) ---")
    print(df[df['position'] != 0])
    
    # Get the final performance numbers
    final_buy_hold = df['buy_hold_total'].iloc[-1]
    final_strategy = df['strategy_total'].iloc[-1]
    
    print("\n--- Final Performance Analysis ---")
    print(f"Total Buy and Hold Return: {final_buy_hold:.2f}x")
    print(f"Total Strategy Return (net of fees): {final_strategy:.2f}x")
    
    if final_strategy > final_buy_hold:
        print("\nCongratulations, the strategy outperformed Buy and Hold!")
    else:
        print("\nThe strategy underperformed Buy and Hold.")

# --- This makes the script runnable ---
if __name__ == "__main__":
    
    # 1. Define Parameters
    TICKER = 'btc-usd'
    START_DATE = '2019-01-01'
    END_DATE = '2024-01-01'
    
    # 2. Run the full process
    data = load_data(TICKER, START_DATE, END_DATE)
    data_with_indicators = calculate_indicators(data)
    strategy_data = create_strategy(data_with_indicators)
    final_data = run_backtest(strategy_data, commission=0.001)
    
    # 3. Show results
    print_results(final_data)